PROJECT_NAME="FLAE Agents"
GOOGLE_APPLICATION_CREDENTIALS="/firebaseadmin.json"
# # Chỉ sử dụng khi ở firebase emulator local
# FIRESTORE_EMULATOR_HOST=firebase-emulator:8080
# FIREBASE_AUTH_EMULATOR_HOST=firebase-emulator:9099
# FIREBASE_STORAGE_EMULATOR_HOST=firebase-emulator:9199
GOOGLE_CLOUD_PROJECT=demo-projects
ENVIRONMENT="local"
TEMPORAL_HOST="localhost:7233"
TEMPORAL_NAMESPACE="default"

# DATABASE 
RAG_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db"
POSTGRES_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/flae_db"
REDIS_URL="redis://localhost:6379/0"

# GEMINI CONFIG
GEMINI_API_KEY=""
GEMINI_LLM_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# LANGSMITH TRACING
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT="FALE-agent"