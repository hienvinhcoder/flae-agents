    "firebase": "^12.16.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.1",
